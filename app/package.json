{
  "name": "@cpe/app",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "pnpm --filter @cpe/tools run build-content",
    "predev": "pnpm run content",
    "dev": "next dev",
    "prebuild": "pnpm run content",
    "build": "next build",
    "start": "next start",
    "preview": "pnpm run content && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "capacity": "tsx scripts/capacity.ts",
    "feedback": "tsx scripts/feedback.ts",
    "deploy": "pnpm run content && opennextjs-cloudflare build && pnpm run capacity && opennextjs-cloudflare deploy",
    "pretest": "pnpm run content",
    "test": "tsx --test test/*.test.ts",
    "pretypecheck": "pnpm run content",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cpe/tools": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "wrangler": "4.142.0"
  }
}
