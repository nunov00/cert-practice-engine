{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cert-practice-engine",
  // Not a secret. The API token is the GitHub secret CLOUDFLARE_API_TOKEN.
  "account_id": "f22757444025afddaad1f69f532c1a1f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Anonymous feedback (docs/feedback.md): filed as files in this private repo,
  // written with the Worker secret FEEDBACK_GITHUB_TOKEN. Not a secret.
  "vars": { "FEEDBACK_REPO": "nunov00/knowmark-feedback" },
  // D1 is the feedback outbox and holds the anonymous daily counters, for feedback
  // limits and for the owner's stats page (docs/analytics.md). Wrangler creates the database on the
  // first deploy (the API token needs D1 Edit); the table is created on first use.
  "d1_databases": [{ "binding": "FEEDBACK_DB", "database_name": "knowmark-feedback" }],
  // Per-visitor limit on feedback posts and inbox attempts. namespace_id must be
  // unique per pilot on the account (docs/platform-limits.md).
  // STATS_LIMITER: bursts of anonymous usage counts (docs/analytics.md).
  "ratelimits": [
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "STATS_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Visual branch previews intentionally inherit no production bindings.
  // The static pages render normally; feedback and stats endpoints need
  // separate preview resources before they can be exercised.
  "previews": {}
}
