{
  "name": "@cpe/tools",
  "private": true,
  "exports": { "./build": "./src/build.ts" },
  "type": "module",
  "scripts": {
    "validate": "tsx src/cli.ts validate --root ..",
    "coverage": "tsx src/cli.ts coverage --root ..",
    "build-content": "tsx src/cli.ts build --root .. --out ../app/src/generated/content.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
