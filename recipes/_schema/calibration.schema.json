{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calibration.schema.json",
  "title": "Difficulty calibration profile (format v0.1)",
  "description": "recipes/<exam>/calibration.yaml. See docs/calibration/standard.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "exam", "outline_version", "calibrated_on", "sources", "method", "official_profile", "targets", "writer_notes", "history"],
  "properties": {
    "format_version": { "const": "0.1" },
    "exam": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "outline_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "calibrated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "used_for"],
        "properties": {
          "kind": { "enum": ["outline", "official_samples", "official_guidance"] },
          "url": { "type": "string", "pattern": "^https://" },
          "used_for": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unavailable": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "method": { "type": "string", "minLength": 20 },
    "official_profile": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options_only_obvious_max", "hard_share_min", "key_only_longest_max", "stem_words"],
      "properties": {
        "options_only_obvious_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "hard_share_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "key_only_longest_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "stem_words": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "writer_notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "scope", "pr", "result"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "scope": { "type": "string", "minLength": 1 },
          "pr": { "type": "integer", "minimum": 1 },
          "result": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
