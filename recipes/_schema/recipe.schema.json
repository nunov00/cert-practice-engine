{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Exam recipe (format v0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "exam", "format", "style", "domains", "bank", "product"],
  "properties": {
    "format_version": { "const": "0.2" },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "issuer", "topic", "disclaimer", "outline"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "topic": {
          "description": "Subject area that groups exams on the home page; one of the ids in tools/src/topics.ts.",
          "type": "string",
          "pattern": "^[a-z][a-z-]*$"
        },
        "disclaimer": { "type": "string", "minLength": 1 },
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_url", "version", "last_checked"],
          "properties": {
            "source_url": { "type": "string", "pattern": "^https://" },
            "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "status": {
              "description": "preview: the issuer has announced the exam but not published its outline. Facts it has not published (domain weights, length, delivery, scoring) and product.mock are then left out.",
              "enum": ["published", "preview"]
            }
          }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_minutes", "question_types"],
      "properties": {
        "delivery": { "enum": ["adaptive", "linear"] },
        "questions": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "integer", "minimum": 1 },
                "max": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "pass"],
          "properties": {
            "scale": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "pass": { "type": "number" }
          }
        },
        "question_types": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["single_choice"] }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "options_per_question", "rules"],
      "properties": {
        "voice": { "type": "string" },
        "options_per_question": { "type": "integer", "minimum": 2, "maximum": 6 },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "subdomains"],
        "properties": {
          "id": { "type": "string", "pattern": "^d[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "subdomains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "target_questions"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
                "title": { "type": "string", "minLength": 1 },
                "target_questions": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_total", "difficulty_mix", "review"],
      "properties": {
        "target_total": { "type": "integer", "minimum": 1 },
        "difficulty_mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["easy", "medium", "hard"],
          "properties": {
            "easy": { "type": "number", "minimum": 0, "maximum": 1 },
            "medium": { "type": "number", "minimum": 0, "maximum": 1 },
            "hard": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["independent_check", "retire_if_report_rate_above", "flag_if_common_wrong_answer_above"],
          "properties": {
            "independent_check": { "type": "boolean" },
            "retire_if_report_rate_above": { "type": "number", "minimum": 0, "maximum": 1 },
            "flag_if_common_wrong_answer_above": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free_sample_per_domain", "unlock", "readiness"],
      "properties": {
        "free_sample_per_domain": { "type": "integer", "minimum": 0 },
        "unlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["price_chf", "access_days"],
          "properties": {
            "price_chf": { "type": "number", "exclusiveMinimum": 0 },
            "access_days": { "type": "integer", "minimum": 1 }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_answered", "min_accuracy_per_domain"],
          "properties": {
            "min_answered": { "type": "integer", "minimum": 0 },
            "min_accuracy_per_domain": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "mock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questions", "minutes", "forms"],
          "properties": {
            "questions": { "type": "integer", "minimum": 1 },
            "minutes": { "type": "integer", "minimum": 1 },
            "forms": { "type": "integer", "minimum": 1 }
          }
        },
        "estimated_pace": {
          "description": "Preview recipes only: an owner-approved estimate of the real exam's pace, used to time the Quick 10 until the outline gives the real one. basis says where the estimate comes from.",
          "type": "object",
          "additionalProperties": false,
          "required": ["questions", "minutes", "basis"],
          "properties": {
            "questions": { "type": "integer", "minimum": 1 },
            "minutes": { "type": "integer", "minimum": 1 },
            "basis": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
